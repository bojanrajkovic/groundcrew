#!/bin/sh
# groundcrew notifier: Pushover.
# Needs PUSHOVER_TOKEN and PUSHOVER_USER in the environment (the daemon's
# EnvironmentFile is inherited). Install: copy anywhere on PATH, or point
# [notify].command at this file directly.
exec curl -fsS --max-time 20 \
  --form-string "token=$PUSHOVER_TOKEN" \
  --form-string "user=$PUSHOVER_USER" \
  --form-string "title=$1" \
  --form-string "message=$2" \
  https://api.pushover.net/1/messages.json
